# Managed by Ansible (role edge_monitoring)
{% for s in monitoring_sites %}
server {
    listen 80;
    server_name {{ s.host }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ s.host }};

    ssl_certificate     /etc/letsencrypt/live/{{ letsencrypt_cert_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ letsencrypt_cert_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
{% if s.auth %}

    auth_basic "ApplyOps monitoring";
    auth_basic_user_file /etc/nginx/.htpasswd-monitoring;
{% endif %}

    location / {
        proxy_pass http://{{ s.ip | default(monitoring_upstream_ip) }}:{{ s.port }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
{% if s.websocket | default(false) %}

    location /api/live/ {
        proxy_pass http://{{ monitoring_upstream_ip }}:{{ s.port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
{% endif %}
}

{% endfor %}
