# Managed by Ansible
RCLONE_CONFIG_HZ_TYPE=s3
RCLONE_CONFIG_HZ_PROVIDER=Other
RCLONE_CONFIG_HZ_ENDPOINT=https://{{ backup_s3_endpoint }}
RCLONE_CONFIG_HZ_REGION={{ backup_s3_region }}
RCLONE_CONFIG_HZ_ACCESS_KEY_ID={{ vault_s3_access_key }}
RCLONE_CONFIG_HZ_SECRET_ACCESS_KEY={{ vault_s3_secret_key }}
RCLONE_CONFIG_HZ_NO_CHECK_BUCKET=true
BACKUP_BUCKET={{ backup_s3_bucket }}
AGE_RECIPIENT={{ backup_age_recipient }}
RETENTION_DAYS={{ backup_retention_days }}
MONGO_CONTAINER={{ mongo_container }}
PUSHGATEWAY_URL={{ pushgateway_url }}
