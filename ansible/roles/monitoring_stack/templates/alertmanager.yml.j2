global:
  smtp_smarthost: '{{ alert_smtp_host }}'
  smtp_from: '{{ alert_smtp_from }}'
  smtp_auth_username: '{{ vault_smtp_user }}'
  smtp_auth_password_file: /etc/alertmanager/smtp_password
  smtp_require_tls: true
  smtp_hello: 'example.com'

route:
  receiver: team-email
  group_by: ['alertname', 'host']
  group_wait: 2m
  group_interval: 15m
  repeat_interval: 24h
  routes:
    - matchers:
        - alertname="Watchdog"
      receiver: 'null'

receivers:
  - name: team-email
    email_configs:
{% for r in alert_recipients %}
      - to: '{{ r }}'
        send_resolved: true
{% endfor %}
  - name: 'null'

inhibit_rules:
  - source_matchers: [severity="critical"]
    target_matchers: [severity="warning"]
    equal: ['alertname', 'host']
