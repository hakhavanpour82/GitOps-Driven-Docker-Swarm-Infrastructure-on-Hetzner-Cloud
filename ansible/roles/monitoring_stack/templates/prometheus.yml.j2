global:
  scrape_interval: 30s
  evaluation_interval: 30s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['alertmanager:9093']

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node
    static_configs:
{% for h in groups['all'] | sort %}
      - targets: ['{{ hostvars[h].private_ip }}:{{ node_exporter_port }}']
        labels:
          host: '{{ h }}'
          role: '{{ hostvars[h].group_names | first }}'
{% endfor %}

  - job_name: cadvisor
    static_configs:
{% for h in groups['app'] | sort %}
      - targets: ['{{ hostvars[h].private_ip }}:{{ cadvisor_port }}']
        labels:
          host: '{{ h }}'
          role: app
{% endfor %}

  - job_name: blackbox_http
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
{% for t in blackbox_http_targets %}
          - {{ t }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115

  - job_name: mongodb
    static_configs:
{% for h in groups['db'] | sort %}
      - targets: ['{{ hostvars[h].private_ip }}:9216']
        labels:
          host: '{{ h }}'
          role: db
{% endfor %}

  - job_name: pushgateway
    honor_labels: true
    static_configs:
      - targets: ['{{ private_ip }}:9091']
