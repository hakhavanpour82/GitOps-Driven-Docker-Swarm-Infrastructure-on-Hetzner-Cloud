---
# Copy to vault.yml and encrypt with: ansible-vault encrypt group_vars/all/vault.yml
vault_smtp_user: "alerts@example.com"
vault_smtp_app_password: "REPLACE_ME"
vault_grafana_admin_password: "REPLACE_ME"
vault_cloudflare_api_token: "REPLACE_ME"
vault_monitoring_basic_auth_password: "REPLACE_ME"
vault_elastic_password: "REPLACE_ME"
vault_kibana_system_password: "REPLACE_ME"
vault_filebeat_writer_password: "REPLACE_ME"
vault_kibana_encryption_key: "REPLACE_WITH_32_PLUS_RANDOM_CHARS"
vault_mongo_root_password: "REPLACE_ME"
vault_mongo_app_password: "REPLACE_ME"
vault_mongo_backup_password: "REPLACE_ME"
vault_mongo_monitor_password: "REPLACE_ME"
vault_mongo_keyfile: "REPLACE_WITH_LONG_RANDOM_STRING"
vault_s3_access_key: "REPLACE_ME"
vault_s3_secret_key: "REPLACE_ME"
vault_gitlab_runner_token: "glrt-REPLACE_ME"
